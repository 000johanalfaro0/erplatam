# =============================================================================
# Plantilla de variables de entorno. Cópiala a `.env` y rellena los valores.
#   cp .env.example .env
# El archivo `.env` real NUNCA se comitea.
# =============================================================================

# --- Base de datos (obligatorio) ---
# Desarrollo local con el Postgres de Prisma:
#   npm run db:up   -> levanta el servidor e imprime la URL
# Producción: cadena de conexión de Neon / Vercel Postgres / Prisma Postgres.
DATABASE_URL="postgres://usuario:contrasena@host:5432/basededatos?sslmode=require"

# Base de datos "sombra" que Prisma usa para calcular migraciones.
# Solo necesaria en desarrollo. En producción se deja vacía.
SHADOW_DATABASE_URL=""

# --- Seguridad (obligatorio) ---
# Secreto de 32+ bytes. Genéralo con:  npm run gen:secret
# Rotarlo invalida todas las sesiones activas.
SESSION_SECRET=""

# --- Aplicación ---
NODE_ENV="development"
# URL pública de la app. Se usa para cookies y cabeceras de seguridad.
APP_URL="http://localhost:3000"

# --- Seed inicial (solo para poblar un entorno nuevo) ---
SEED_ADMIN_EMAIL="admin@erp.local"
SEED_ADMIN_PASSWORD=""
SEED_BUSINESS_NAME="Negocio Demo"
